+++ b/iokit/Kernel/arm/SweetNet.cpp
@@ -0,0 +1,168 @@
+/*
+ * IOKit side of the QEMU virtio-net interface (bsd/dev/sweet_vnet.c).
+ *
+ * configd's InterfaceNamer only configures interfaces it finds in IOKit: an
+ * IONetworkInterface (IOInterfaceType, IOInterfaceUnit, BSD Name, ...) whose
+ * parent controller carries IOMACAddress, and it waits for an
+ * IONetworkStack it can open. IONetworkingFamily is a kext that this kernel
+ * does not have, so these are minimal stand-ins with the same class names:
+ * the BSD ifnet already exists and is named, so the stack's naming command
+ * has nothing to do.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSString.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int sweet_vnet_start(uint8_t *mac);
+extern "C" void sweet_net_publish_interface(const uint8_t *mac, unsigned unit);
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController {
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class IONetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject *properties __unused)
+{
+	/* Register-interface commands: en0 is named by the driver already. */
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+class IONetworkStack : public IOService {
+	OSDeclareDefaultStructors(IONetworkStack);
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+IOReturn
+IONetworkStack::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	IONetworkStackUserClient *client = OSTypeAlloc(IONetworkStackUserClient);
+
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type) || !client->attach(this)) {
+		client->release();
+		return kIOReturnError;
+	}
+	if (!client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnError;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+class SweetVirtioNet : public IOEthernetController {
+	OSDeclareDefaultStructors(SweetVirtioNet);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetVirtioNet, IOEthernetController);
+
+static SweetVirtioNet *gSweetNet;
+
+bool
+SweetVirtioNet::start(IOService *provider)
+{
+	int on = 0;
+	uint8_t mac[6];
+
+	(void)PE_parse_boot_argn("sweetvnet", &on, sizeof(on));
+	if (!on || !IOService::start(provider)) {
+		return false;
+	}
+	if (sweet_vnet_start(mac) != 0) {
+		return false;
+	}
+	setProperty("IOMACAddress", mac, sizeof(mac));
+	setProperty("IOVendor", "QEMU");
+	setProperty("IOModel", "virtio-net");
+	setProperty("IOLinkStatus", 3ULL, 32);          /* valid | active */
+	setProperty("IOLinkSpeed", 1000000000ULL, 64);
+	setProperty("IOFeatures", 0ULL, 32);
+	gSweetNet = this;
+	registerService();
+
+	IONetworkStack *stack = OSTypeAlloc(IONetworkStack);
+	if (stack != NULL) {
+		if (stack->init() && stack->attach(provider)) {
+			if (stack->start(provider)) {
+				stack->registerService();
+			} else {
+				stack->detach(provider);
+			}
+		}
+		stack->release();
+	}
+	IOLog("SWEET VNET: controller and IONetworkStack registered\n");
+	return true;
+}
+
+/* Called from the driver thread once the ifnet en<unit> is attached. */
+extern "C" void
+sweet_net_publish_interface(const uint8_t *mac, unsigned unit)
+{
+	IOEthernetInterface *netif;
+	char bsd[8];
+
+	if (gSweetNet == NULL || (netif = OSTypeAlloc(IOEthernetInterface)) == NULL) {
+		return;
+	}
+	if (!netif->init()) {
+		netif->release();
+		return;
+	}
+	snprintf(bsd, sizeof(bsd), "en%u", unit);
+	netif->setProperty("IOInterfaceType", 6ULL, 32);       /* IFT_ETHER */
+	netif->setProperty("IOInterfaceUnit", (unsigned long long)unit, 32);
+	netif->setProperty("IOInterfaceNamePrefix", "en");
+	netif->setProperty("BSD Name", bsd);
+	netif->setProperty("IOBuiltin", true);
+	netif->setProperty("IOPrimaryInterface", true);
+	netif->setProperty("IOLocation", "");
+	netif->setProperty("IOMaxTransferUnit", 1500ULL, 32);
+	netif->setProperty("IOMACAddress", (void *)mac, 6);
+	if (netif->attach(gSweetNet)) {
+		netif->registerService();
+		IOLog("SWEET VNET: IOEthernetInterface %s registered\n", bsd);
+	}
+	netif->release();
+}
